# Copie para .env.production (ou configure no painel da hospedagem) e informe
# a URL pública da API hospedada na issue #38.
# Exemplo: https://sua-api.onrender.com
VITE_API_URL=https://sua-api.onrender.com

# Opcional: use apenas se a aplicação for publicada em um subdiretório,
# como no GitHub Pages (ex.: /Vue_DFE/). Em hospedagens de raiz, deixe vazio.
# VITE_BASE_PATH=/Vue_DFE/
